# Copy to .env to override the defaults used by docker-compose.yml.
POSTGRES_USER=connect4
POSTGRES_PASSWORD=connect4
POSTGRES_DB=connect4

# Used when running the Go backend directly on your machine (not in Docker):
#   export $(grep -v '^#' .env | xargs) && cd backend && go run ./cmd/server
DATABASE_URL=postgres://connect4:connect4@localhost:5432/connect4?sslmode=disable
API_PORT=8080
